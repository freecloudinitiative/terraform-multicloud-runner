#!/bin/bash
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y \
  curl \
  wget \
  jq \
  tar \
  unzip \
  libicu-dev \
  build-essential \
  make \
  git \
  rsync \
  ca-certificates \
  gnupg \
  sudo \
  python3 \
  python3-pip \
  python3-venv \
  docker.io \
  docker-buildx

# Node.js LTS — hashicorp/setup-terraform wrapper and Actions that expect `node` on PATH
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
apt-get update -y
apt-get install -y nodejs

# Enable and start Docker daemon
systemctl enable --now docker || service docker start

# Create runner user (GitHub runner cannot run as root)
useradd -m -s /bin/bash github || true
usermod -aG docker github
cd /home/github

# Detect system architecture dynamically
ARCH=$(uname -m)
case $ARCH in
  x86_64) RUNNER_ARCH="x64" ;;
  aarch64|arm64) RUNNER_ARCH="arm64" ;;
  *) RUNNER_ARCH="arm64" ;;
esac

# Download runner package
RUNNER_VERSION="2.336.0"
TARBALL="/home/github/actions-runner-linux-$${RUNNER_ARCH}-$${RUNNER_VERSION}.tar.gz"
curl -o "$TARBALL" -L "https://github.com/actions/runner/releases/download/v$${RUNNER_VERSION}/actions-runner-linux-$${RUNNER_ARCH}-$${RUNNER_VERSION}.tar.gz"
chown github:github "$TARBALL"

# If no PAT is provided, exit early (user can configure manually)
if [ -z "${github_pat}" ]; then
  echo "No GitHub PAT provided. Exiting runner setup."
  exit 0
fi

# Configure system limits for high concurrency CI workloads
cat << 'EOF' > /etc/sysctl.d/99-runner-limits.conf
fs.inotify.max_user_watches = 1048576
fs.inotify.max_user_instances = 8192
fs.file-max = 2097152
EOF
sysctl --system || true

cat << 'EOF' >> /etc/security/limits.conf
* soft nofile 1048576
* hard nofile 1048576
root soft nofile 1048576
root hard nofile 1048576
github soft nofile 1048576
github hard nofile 1048576
EOF

# Set up 8GB swap space to prevent OOM kills on memory-heavy CI jobs
if [ ! -f /swapfile ]; then
  fallocate -l 8G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=8192
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# Fetch dynamic runner registration token from GitHub API using the PAT
REG_TOKEN=$(curl -sX POST -H "Authorization: token ${github_pat}" \
  -H "Accept: application/vnd.github.v3+json" \
  https://api.github.com/orgs/${github_org}/actions/runners/registration-token | jq -r .token)

RUNNER_COUNT=${runners_per_vm}

for i in $(seq 1 $RUNNER_COUNT); do
  RUNNER_DIR="/home/github/runner-$i"
  mkdir -p "$RUNNER_DIR"
  tar xzf "$TARBALL" -C "$RUNNER_DIR"
  chown -R github:github "$RUNNER_DIR"

  cd "$RUNNER_DIR"
  sudo -u github ./config.sh --url "https://github.com/${github_org}" \
    --token "$REG_TOKEN" \
    --unattended \
    --replace \
    --name "$(hostname -s)-runner-$i"

  ./svc.sh install github

  # Ensure systemd auto-restarts the runner service on failure
  SVC_NAME="actions.runner.${github_org}.$(hostname -s)-runner-$i.service"
  mkdir -p "/etc/systemd/system/$${SVC_NAME}.d"
  cat << 'EOF' > "/etc/systemd/system/$${SVC_NAME}.d/override.conf"
[Service]
Restart=always
RestartSec=5s
EOF
  systemctl daemon-reload
  ./svc.sh start
done
